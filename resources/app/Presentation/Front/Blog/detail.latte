{templateType App\Presentation\Front\Blog\BlogTemplate}

{block content}
	<article class="mx-auto" style="max-width: 48rem">
		<a n:href="default" class="d-inline-block mb-4 small link-secondary text-decoration-none">&larr; {_'Blog'}</a>
		<h1 n:block="title" class="display-6 fw-semibold mb-3">{$article->title}</h1>
		<p n:if="$article->perex" class="lead text-body-secondary">{$article->perex}</p>

		{* author, date and category, separated by dots *}
		<div class="d-flex flex-wrap align-items-center gap-2 mb-4 small text-body-secondary">
			{if $author}
				<img src={$author[avatar]} alt="" width="24" height="24" class="rounded-circle">
				<span class="fw-semibold text-body">{$author[name]}</span>
			{/if}
			{if $article->published_at}
				<span n:if="$author" aria-hidden="true">&middot;</span>
				<time datetime={$article->published_at|date:'c'} title={$article->published_at|date:'j. n. Y'}>{$article->published_at|ago}</time>
			{/if}
			{if $category}
				<span n:if="$author || $article->published_at" aria-hidden="true">&middot;</span>
				<a n:href="category, category: $category->slug" class="link-secondary">{$category->name}</a>
			{/if}
		</div>

		<div n:if="$article->image" class="ratio ratio-21x9 rounded-3 overflow-hidden mb-4">
			<img src="{$basePath}/{App\Model\Blog\ArticleImages::Path}/{$article->image}" alt="" class="object-fit-cover" style="object-position: top">
		</div>

		<div class="content blog-content mt-4">
			{$content|noescape}
		</div>

		<section n:if="$commentsEnabled" id="comments" class="mt-5 pt-4">
			<h2 class="h4 mb-4">{_'Comments'} <span class="text-body-secondary fw-normal">({count($comments)})</span></h2>
			<div class="vstack gap-3">
				{foreach $comments as $comment}
					{var int $number = $commentNumbers[$comment->id]}
					<article id="comment-{$number}" class="comment p-4 bg-body-tertiary rounded-4">
						<div class="small mb-2">
							<span class="fw-semibold">{$comment->author_name}</span>
							<a href="#comment-{$number}" class="link-secondary text-decoration-none">#{$number}</a>
							<span class="text-body-secondary">&middot; {$comment->created_at|date:'j. n. Y H:i'}</span>
						</div>
						<div class="comment-content">{$commentHtml[$comment->id]|noescape}</div>
						<div class="d-flex flex-wrap column-gap-2 mt-2 small text-body-secondary">
							{* front.js inserts "#2 Name " into the comment form; without JavaScript the link only goes to the form *}
							<a href="#comment-form" class="link-secondary" data-comment-reply="#{$number} {$comment->author_name} ">{_'Reply'}</a>
							{if isset($commentReplies[$number])}
								<span aria-hidden="true">&middot;</span>
								<span>
									{_'Replies:'}
									{foreach $commentReplies[$number] as $reply}
										<a href="#comment-{$reply}" class="link-secondary">#{$reply} {$commentNames[$reply]}</a>{sep}, {/sep}
									{/foreach}
								</span>
							{/if}
						</div>
					</article>
				{else}
					<p class="text-body-secondary mb-0">{_'No comments yet.'}</p>
				{/foreach}
			</div>

			<div id="comment-form" class="mt-5 p-4 bg-body-tertiary rounded-4">
				{embed '../../Accessory/Widget/@form.latte', name: 'comment'}
					{block form}
						{if $commentAuthor}
							<p class="col-12 small text-body-secondary mb-0">{_'You are commenting as %s.', $commentAuthor}</p>
						{else}
							{include input, name: 'name', columns: 6}
							{include input, name: 'email', columns: 6}
						{/if}
						{include input, type: 'textarea', name: 'content', rows: 5}
						<div class="d-none" aria-hidden="true">{input website}</div>
						<div class="col-12">
							<p class="small text-body-secondary">{_'Comments appear after approval.'}</p>
							{include submit, name: 'send'}
						</div>
					{/block}
				{/embed}
			</div>
		</section>
	</article>
{/block}

{* An article in a list: a card with a wide image, date and category, title, perex and author; the whole card is a link. *}
{* Also used by the home page of drago-ex/project-front-ui. *}
{varType App\Model\Blog\ArticleEntity $article}
{default ?array $author = null}
{default ?App\Model\Blog\CategoryEntity $category = null}
{default ?int $commentCount = null}

<article class="blog-card">
	<div n:if="$article->image" class="blog-card-image">
		<img src="{$basePath}/{App\Model\Blog\ArticleImages::Path}/{$article->image}" alt="" loading="lazy">
	</div>

	<div n:if="$article->publishedAt || $category" class="blog-meta">
		<time n:if="$article->publishedAt" datetime={$article->publishedAt|date:'c'} title={$article->publishedAt|date:'j. n. Y'}>{$article->publishedAt|ago}</time>
		<a n:if="$category" n:href=":Front:Blog:category, category: $category->slug" class="blog-over">{$category->name}</a>
	</div>

	<h2 class="blog-card-title"><a n:href=":Front:Blog:detail, slug: $article->slug" class="stretched-link">{$article->title}</a></h2>
	<p n:if="$article->perex" class="blog-card-text">{$article->perex}</p>

	<div n:if="$author || $commentCount !== null" class="blog-card-footer">
		<div n:if="$author" class="blog-author">
			<span class="avatar avatar-sm"><img src={$author[avatar]} alt="" width="24" height="24" loading="lazy"></span>
			<span>{$author[name]}</span>
		</div>
		<a n:if="$commentCount !== null" n:href=":Front:Blog:detail#comments, slug: $article->slug" class="blog-over ms-auto">{_'Comments: %d', $commentCount}</a>
	</div>
</article>

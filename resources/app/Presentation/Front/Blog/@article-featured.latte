{* The newest article of a list over the whole row: a large image beside the title, perex and author; the whole block is a link. *}
{* Also used by the home page of drago-ex/project-front-ui. *}
{varType App\Model\Blog\ArticleEntity $article}
{default ?array $author = null}
{default ?App\Model\Blog\CategoryEntity $category = null}
{default ?int $commentCount = null}

<article class="blog-featured">
	<div n:if="$article->image" class="blog-featured-image">
		<img src="{$basePath}/{App\Model\Blog\ArticleImages::Path}/{$article->image}" alt="">
	</div>

	<div class="blog-featured-body">
		<div n:if="$category || $commentCount !== null" class="blog-meta">
			<a n:if="$category" n:href=":Front:Blog:category, category: $category->slug" class="blog-over">{$category->name}</a>
			<a n:if="$commentCount !== null" n:href=":Front:Blog:detail#comments, slug: $article->slug" class="blog-over">{_'Comments: %d', $commentCount}</a>
		</div>

		<h2 class="blog-card-title"><a n:href=":Front:Blog:detail, slug: $article->slug" class="stretched-link">{$article->title}</a></h2>
		<p n:if="$article->perex" class="blog-card-text">{$article->perex}</p>

		<div n:if="$author || $article->publishedAt" class="blog-author">
			<span n:if="$author" class="avatar avatar-lg"><img src={$author[avatar]} alt="" width="48" height="48"></span>
			<div>
				<div n:if="$author" class="blog-author-name">{$author[name]}</div>
				<time n:if="$article->publishedAt" datetime={$article->publishedAt|date:'c'} title={$article->publishedAt|date:'j. n. Y'}>{$article->publishedAt|ago}</time>
			</div>
		</div>
	</div>
</article>

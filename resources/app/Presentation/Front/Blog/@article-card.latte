{* A card of an article in a list: cover image, category, title, perex, author with avatar and date. *}
{* Also used by the home page of drago-ex/project-preset. *}
{varType App\Model\Blog\ArticleEntity $article}
{default ?array $author = null}
{default ?App\Model\Blog\CategoryEntity $category = null}
{default ?int $commentCount = null}

<article class="card h-100 border-0 shadow-sm blog-card">
	<a n:href=":Front:Blog:detail, slug: $article->slug" class="ratio ratio-16x9 d-block rounded-top overflow-hidden bg-body-tertiary" tabindex="-1" aria-hidden="true">
		{if $article->image}
			<img src="{$basePath}/{App\Model\Blog\ArticleImages::Path}/{$article->image}" alt="" class="object-fit-cover" style="object-position: top" loading="lazy">
		{else}
			<span class="d-flex align-items-center justify-content-center display-5 text-body-tertiary">{$article->title|substr:0,1|upper}</span>
		{/if}
	</a>

	<div class="card-body d-flex flex-column">
		<a n:if="$category" n:href=":Front:Blog:category, category: $category->slug" class="small text-uppercase fw-semibold link-secondary text-decoration-none mb-2">
			{$category->name}
		</a>
		<h2 class="h5 card-title">
			<a n:href=":Front:Blog:detail, slug: $article->slug" class="text-decoration-none text-body-emphasis">{$article->title}</a>
		</h2>
		<p n:if="$article->perex" class="card-text text-body-secondary">{$article->perex|truncate:180}</p>

		<div class="d-flex align-items-center gap-2 mt-auto pt-2 small text-body-secondary">
			<img n:if="$author" src={$author[avatar]} alt="" width="40" height="40" class="rounded-circle" loading="lazy">
			<div>
				<div n:if="$author" class="fw-semibold text-body">{$author[name]}</div>
				<time n:if="$article->published_at" datetime={$article->published_at|date:'c'} title={$article->published_at|date:'j. n. Y'}>{$article->published_at|ago}</time>
				{if $commentCount !== null}
					&middot; <a n:href=":Front:Blog:detail#comments, slug: $article->slug" class="link-secondary">{_'Comments: %d', $commentCount}</a>
				{/if}
			</div>
		</div>
	</div>
</article>

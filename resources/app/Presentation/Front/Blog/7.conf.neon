extensions:
	# Texy, its toolbar and the code highlighter (drago-ex/texy-toolbar); other packages may register it too
	texy: Drago\Texy\DI\TexyExtension

	# avatars of the authors (drago-ex/gravatar); other packages may register it too
	gravatar: Drago\Gravatar\DI\GravatarExtension


latte:
	extensions:
		# the filter |ago for the dates of articles ("2 months ago")
		- App\Presentation\Front\Blog\TimeAgoExtension


services:

	# before the front router (9.conf.neon), whose <presenter>/<action> would take the blog addresses
	router: {setup: {add(@router.blog)}}
	router.blog: {factory: App\Presentation\Front\Blog\BlogRouter::create, autowired: no}

	# cover images in www/upload/blog/, the authors of articles and the article lists of the front
	- App\Model\Blog\ArticleImages(%appDir%/../www)
	- App\Model\Blog\ArticleAuthors
	- App\Model\Blog\ArticleListFactory

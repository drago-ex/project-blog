# Item of the administration menu (drago-ex/project-backend-ui merges the sidebar parameter of all packages).
parameters:
	sidebar:
		Content:
			# articles with their comments; the categories are opened from the articles
			- {title: Blog, link: 'Blog:', icon: fa-regular fa-newspaper bell, allowAny: [Backend:Blog, default-read]}


services:
	# the number of comments waiting for approval next to "Blog" (read by drago-ex/project-backend-ui)
	- {factory: App\Presentation\Backend\Blog\CommentBadge, tags: [sidebar.badge], autowired: no}

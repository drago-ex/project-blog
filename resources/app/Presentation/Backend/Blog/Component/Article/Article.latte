{templateType App\Presentation\Backend\Blog\Component\Article\ArticleTemplate}
{embed '../../../../Accessory/Widget/@offcanvas.latte', offcanvasId: $offcanvasId, size: '100vw', mainImage: $mainImage, newCategory: $newCategory,
	confirmRemoveImage: $confirmRemoveImage, articleId: $articleId, comments: $comments, commentHtml: $commentHtml,
	confirmDeleteComment: $confirmDeleteComment}
	{block title}{_'Manage article'}{/block}
	{block body}
		{snippet offcanvas}
			{* an edited article has its comments in a second tab; they are not in the form, so no error is hidden *}
			<ul n:if="$articleId" class="nav nav-pills gap-2 mb-3" role="tablist">
				<li class="nav-item" role="presentation">
					<button class="nav-link active" type="button" role="tab" data-bs-toggle="pill" data-bs-target="#article-tab-form" aria-controls="article-tab-form" aria-selected="true">
						{_'Article'}
					</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link" type="button" role="tab" data-bs-toggle="pill" data-bs-target="#article-tab-comments" aria-controls="article-tab-comments" aria-selected="false">
						{_'Comments'} <span n:snippet="commentCount" class="opacity-75">({count($comments)})</span>
					</button>
				</li>
			</ul>

			<div class="tab-content">
				<div class="tab-pane fade show active" id="article-tab-form" role="tabpanel">
					{embed '../../../../Accessory/Widget/@form.latte', class: 'ajax', name: 'article', najaHistory: 'off', mainImage: $mainImage,
						newCategory: $newCategory, confirmRemoveImage: $confirmRemoveImage, articleId: $articleId}
						{import '../../../../Accessory/Widget/@dismiss-button.latte'}
						{block form}
							{* the text of the article on the left, its settings in cards on the right; nothing is hidden,
							   so every error is visible, and the buttons stay at the bottom while the content scrolls *}
							<div class="col-lg-8">
								<div class="row g-3">
									{include input, name: 'title'}
									{* the height follows the window, so the whole form fits without scrolling the page *}
									<div class="col-12 form-error">
										{label content, class => 'form-label fw-semibold' /}
										{input content, class => 'form-control', style => 'height: calc(100vh - 22rem); min-height: 14rem'}
									</div>
								</div>
							</div>

							<div class="col-lg-4">
								<div class="vstack gap-3">
									<section class="card border-0 shadow-sm bg-body-tertiary">
										<div class="card-body">
											<div class="row g-3">
												{include input, type: 'select', name: 'status'}
												{include input, name: 'publishedAt'}
												{* a category is chosen, or written right here by the + button; a written one is used instead of the select,
												   so the × button empties it when it switches back to the select *}
												<div class="col-12 form-error">
													{label categoryId, class => 'form-label fw-semibold' /}
													<div n:class="article-category, collapse, !$newCategory ? show">
														<div class="input-group">
															{input categoryId, class => 'form-select'}
															<button type="button" class="btn btn-primary" data-bs-toggle="collapse" data-bs-target=".article-category"
																title="{_'New category'}" aria-label="{_'New category'}">
																<i class="fa-solid fa-plus"></i>
															</button>
														</div>
													</div>
													<div n:class="article-category, collapse, $newCategory ? show">
														<div class="input-group">
															{input newCategory, class => 'form-control'}
															<button type="button" class="btn btn-dark" data-bs-toggle="collapse" data-bs-target=".article-category"
																onclick="this.parentElement.querySelector('input').value = ''"
																title="{_'Choose a category'}" aria-label="{_'Choose a category'}">
																<i class="fa-solid fa-xmark"></i>
															</button>
														</div>
													</div>
												</div>
												{include checkbox, name: 'commentsEnabled'}
											</div>
										</div>
									</section>

									<section class="card border-0 shadow-sm bg-body-tertiary">
										<div class="card-body">
											{* the image is removed at once by a signal, which redraws only it, so unsaved changes stay *}
											<div n:snippet="mainImage">
												<div n:if="$mainImage" class="position-relative mb-3">
													<img src="{$basePath}/{App\Model\Blog\ArticleImages::Path}/{$mainImage}" alt="" class="w-100 rounded object-fit-cover" style="max-height: 10rem; object-position: top">
													<div class="article-image-actions position-absolute top-0 end-0 m-2 d-flex flex-wrap justify-content-end align-items-center gap-2">
														{if $confirmRemoveImage}
															<span class="badge text-bg-light">{_'Remove the main image?'}</span>
															<a n:href="removeImage!, id: $articleId" class="ajax btn btn-xs btn-danger" data-naja-history="off">{_'Remove'}</a>
															<a n:href="cancelRemoveImage!, id: $articleId" class="ajax btn btn-xs btn-secondary" data-naja-history="off">{_'Cancel'}</a>
														{else}
															<a n:href="confirmRemoveImage!, id: $articleId" class="ajax btn btn-sm btn-danger" data-naja-history="off"
																title="{_'Remove the main image'}" aria-label="{_'Remove the main image'}">
																<i class="fa-regular fa-trash-can"></i>
															</a>
														{/if}
													</div>
												</div>
											</div>
											<div class="row g-3">
												{include input, name: 'upload'}
												<div class="col-12 form-text mt-1">{_'JPEG, PNG, GIF or WebP, at most 8 MB.'}</div>
											</div>
										</div>
									</section>

									<section class="card border-0 shadow-sm bg-body-tertiary">
										<div class="card-body">
											<div class="row g-3">
												{include input, name: 'slug'}
												{include input, type: 'textarea', name: 'perex', rows: 3}
											</div>
										</div>
									</section>
								</div>
							</div>

							{* moved down by the padding of the offcanvas body, so no content shows below the bar *}
							<div class="col-12 sticky-bottom bg-body pt-3 d-flex justify-content-end gap-2" style="bottom: calc(-1 * var(--bs-offcanvas-padding-y)); padding-bottom: calc(1rem + var(--bs-offcanvas-padding-y))">
								{include buttonDismiss, type: 'offcanvas'}
								{include submit, name: 'send'}
							</div>
						{/block}
					{/embed}
				</div>

				<div n:if="$articleId" class="tab-pane fade" id="article-tab-comments" role="tabpanel">
					{* the comment signals redraw only this snippet, so unsaved changes of the form stay *}
					{snippet comments}
						<div class="vstack gap-3" style="max-width: 60rem">
							{foreach $comments as $comment}
								<article class="p-3 bg-body-tertiary rounded-3">
									<div class="d-flex flex-wrap align-items-center column-gap-2 small mb-2">
										<span class="fw-semibold">{$comment->authorName}</span>
										<span n:if="$comment->authorEmail" class="text-body-secondary">{$comment->authorEmail}</span>
										<span class="text-body-secondary">&middot; {$comment->createdAt|date:'j. n. Y H:i'}</span>
										<span n:if="!$comment->approved" class="badge rounded-pill text-bg-accent">{_'Waiting for approval'}</span>
									</div>
									<div class="mb-2">{$commentHtml[$comment->id]|noescape}</div>

									<div class="article-comment-actions d-flex flex-wrap align-items-center gap-2">
										{if $confirmDeleteComment === $comment->id}
											<span class="small fw-semibold text-danger">{_'Are you sure you want to delete the item?'}</span>
											<a n:href="deleteComment!, id: $comment->id" class="ajax btn btn-xs btn-danger" data-naja-history="off">{_'Delete'}</a>
											<a n:href="cancelDeleteComment!, id: $comment->id" class="ajax btn btn-xs btn-secondary" data-naja-history="off">{_'Cancel'}</a>
										{else}
											<a n:if="!$comment->approved" n:href="approveComment!, id: $comment->id" class="ajax btn btn-xs btn-success" data-naja-history="off">{_'Approve'}</a>
											<a n:href="confirmDeleteComment!, id: $comment->id" class="ajax btn btn-xs btn-danger" data-naja-history="off">{_'Delete'}</a>
										{/if}
									</div>
								</article>
							{else}
								<p class="text-body-secondary mb-0">{_'No comments yet.'}</p>
							{/foreach}
						</div>
					{/snippet}
				</div>
			</div>
		{/snippet}
	{/block}
{/embed}

{embed '../../../../Accessory/Widget/@modal.latte', modalId: $modalId, options: [header: 'danger']}
	{block title}{_'Confirm delete'}{/block}
	{block body}
		{snippet content}
			{include '../@modal-body.latte'}
		{/snippet}
	{/block}
	{block footer}
		{snippet modal}
			{include '../@modal-footer.latte'}
		{/snippet}
	{/block}
{/embed}

{embed '../@datagrid-heading.latte', addButton: true}
	{block title}
		{_'Blog articles'}
	{/block}
	{block buttons}
		{* categories are created in the article form; their page is for renaming and deleting them *}
		<a href="{plink :Backend:Blog:categories}" class="btn btn-secondary btn-xs">{_'Categories'}</a>
	{/block}
{/embed}

{control dataGrid}

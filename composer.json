{
	"name": "drago-ex/project-blog",
	"description": "Blog articles and comments for Drago Project.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"ext-gd": "*",
		"ext-intl": "*",
		"nette/application": "^3.2",
		"nette/di": "^3.2",
		"drago-ex/application": "^4.0",
		"drago-ex/component": "^3.0",
		"drago-ex/database": "^5.0",
		"drago-ex/datagrid": "^1.0",
		"drago-ex/form": "^3.0",
		"drago-ex/migration": "^1.0",
		"drago-ex/project-auth": "^2.0",
		"drago-ex/project-backend": "^1.0",
		"drago-ex/translator": "^4.0.1",
		"drago-ex/utils": "^2.0",
		"drago-ex/texy-toolbar": "^1.0",
		"drago-ex/gravatar": "^2.1.1",
		"drago-ex/permission": "^2.0"
	},
	"suggest": {
		"drago-ex/project-permission": "Administration of custom roles and their privileges.",
		"drago-ex/project-backend-ui": "Administration layout; the blog administration uses its content widget and gets its menu item from Backend/Blog/6.menu.neon."
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app/Model": "app/Model",
					"resources/app/Presentation/Backend": "app/Presentation/Backend",
					"resources/app/Presentation/Front": "app/Presentation/Front",
					"resources/assets/naja": "assets/naja"
				}
			}
		},
		"drago-translator": {
			"translation": "app/Presentation/Backend/Blog/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
